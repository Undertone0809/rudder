{
  "name": "@rudderhq/server",
  "version": "0.7.6",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Undertone0809/rudder",
  "bugs": {
    "url": "https://github.com/Undertone0809/rudder/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Undertone0809/rudder",
    "directory": "server"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "resources",
    "ui-dist",
    "skills"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "collector": "tsx src/product-analytics-collector-server.ts",
    "collector:dev": "tsx watch src/product-analytics-collector-server.ts",
    "dev:watch": "cross-env RUDDER_MIGRATION_PROMPT=never RUDDER_MIGRATION_AUTO_APPLY=true tsx watch --ignore ../ui/node_modules --ignore ../ui/.vite --ignore ../ui/dist src/index.ts",
    "prepare:ui-dist": "node ../scripts/prepare-server-ui-dist.mjs",
    "build": "node ../scripts/build-tsc-copy-assets.mjs --copy src/onboarding-assets dist/onboarding-assets",
    "postinstall": "node resources/postinstall-postgres-compat.mjs",
    "prepack": "pnpm run prepare:ui-dist",
    "postpack": "rm -rf ui-dist",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "collector:start": "node dist/product-analytics-collector-server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1015.0",
    "@larksuiteoapi/node-sdk": "1.67.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@rudderhq/agent-runtime-claude-local": "workspace:*",
    "@rudderhq/agent-runtime-codex-local": "workspace:*",
    "@rudderhq/agent-runtime-cursor-local": "workspace:*",
    "@rudderhq/agent-runtime-gemini-local": "workspace:*",
    "@rudderhq/agent-runtime-hermes-gateway": "workspace:*",
    "@rudderhq/agent-runtime-openclaw-gateway": "workspace:*",
    "@rudderhq/agent-runtime-opencode-local": "workspace:*",
    "@rudderhq/agent-runtime-pi-local": "workspace:*",
    "@rudderhq/agent-runtime-utils": "workspace:*",
    "@rudderhq/db": "workspace:*",
    "@rudderhq/identity-core": "workspace:*",
    "@rudderhq/run-intelligence-core": "workspace:*",
    "@rudderhq/shared": "workspace:*",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.6.23",
    "chokidar": "^4.0.3",
    "detect-port": "^2.1.0",
    "dompurify": "^3.4.11",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "18.1.0-beta.16",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "gpt-tokenizer": "3.4.0",
    "hermes-paperclip-adapter": "0.3.0",
    "ipaddr.js": "^1.9.1",
    "jsdom": "^28.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "multer": "^2.2.0",
    "open": "^11.0.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.8",
    "sharp": "^0.34.5",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsdom": "^28.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.7"
  }
}
