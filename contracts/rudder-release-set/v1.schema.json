{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rudderhq.dev/contracts/rudder-release-set/v1.schema.json",
  "title": "Rudder signed release-set envelope v1",
  "description": "Structural wire contract for a signed Rudder release set. Ordering and cross-field compatibility invariants are enforced by the reference semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keyId", "payload", "signature"],
  "properties": {
    "schema": { "const": "rudder.signed-release-set/v1" },
    "keyId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "payload": { "$ref": "#/$defs/manifest" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "releaseId",
        "version",
        "channel",
        "sourceSha",
        "compatibility",
        "minimumUpdaterVersion",
        "artifacts",
        "bootstrap",
        "electronHandoff"
      ],
      "properties": {
        "schema": { "const": "rudder.release-set/v1" },
        "releaseId": { "type": "string", "minLength": 8, "maxLength": 160 },
        "version": { "$ref": "#/$defs/version" },
        "channel": { "enum": ["stable", "canary"] },
        "sourceSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "compatibility": { "$ref": "#/$defs/compatibility" },
        "minimumUpdaterVersion": { "$ref": "#/$defs/version" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "bootstrap": { "$ref": "#/$defs/bootstrap" },
        "electronHandoff": { "$ref": "#/$defs/electronHandoff" }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseEpoch", "databaseEpoch", "bootstrapFromEpochs", "readableDatabaseEpochs", "rollbackToEpochs"],
      "properties": {
        "releaseEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "databaseEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "bootstrapFromEpochs": { "$ref": "#/$defs/epochSet" },
        "readableDatabaseEpochs": { "$ref": "#/$defs/epochSet" },
        "rollbackToEpochs": { "$ref": "#/$defs/epochSet" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "sha256", "bytes", "platform", "arch"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "kind": { "enum": ["npm", "desktop-portable", "desktop-shell", "native", "runtime", "checksum"] },
        "version": { "$ref": "#/$defs/version" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "platform": { "$ref": "#/$defs/nullableIdentity" },
        "arch": { "$ref": "#/$defs/nullableIdentity" }
      }
    },
    "nullableIdentity": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxStageAttempts", "maxProbeAttempts", "probeTimeoutMs", "drainTimeoutMs"],
      "properties": {
        "maxStageAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxProbeAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "probeTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "drainTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }
      }
    },
    "electronHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shellAuthority", "admissionAuthority", "destructiveAuthority", "rollbackAuthority"],
      "properties": {
        "shellAuthority": { "const": "electron" },
        "admissionAuthority": { "const": "electron" },
        "destructiveAuthority": { "const": "rudder-update-helper/v1" },
        "rollbackAuthority": { "const": "rudder-update-helper/lkg-v1" }
      }
    },
    "epochSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
    }
  },
  "x-rudder-semantic-invariants": [
    "artifact ids and compatibility epoch arrays are canonical and sorted",
    "artifact ids are unique and each artifact version equals payload.version",
    "readableDatabaseEpochs contains databaseEpoch",
    "the exact expected artifact set, updater scope, transition compatibility, and Ed25519 trust root are verified by the consuming authority"
  ]
}
