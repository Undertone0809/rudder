# Copy to .env only after provisioning a private deployment. Never commit the
# populated file. Values below are placeholders, not production credentials.
TELEMETRY_POSTGRES_DB=rudder_analytics
TELEMETRY_POSTGRES_ADMIN_USER=postgres
TELEMETRY_POSTGRES_ADMIN_PASSWORD=replace-with-a-random-admin-secret
TELEMETRY_MIGRATION_USER=telemetry_migrator
TELEMETRY_MIGRATION_PASSWORD=replace-with-a-random-migration-secret
TELEMETRY_COLLECTOR_USER=rudder_analytics_collector
TELEMETRY_COLLECTOR_PASSWORD=replace-with-a-random-collector-secret
TELEMETRY_ROLLUP_USER=rudder_analytics_rollup
TELEMETRY_ROLLUP_PASSWORD=replace-with-a-random-rollup-secret
TELEMETRY_READER_USER=rudder_analytics_reader
TELEMETRY_READER_PASSWORD=replace-with-a-random-reader-secret
IDENTITY_TELEMETRY_PUBLIC_KEY=replace-with-identity-ed25519-public-key
IDENTITY_TELEMETRY_ISSUER=https://identity.example.invalid
IDENTITY_TELEMETRY_KEY_ID=telemetry-key-production
TELEMETRY_ANONYMOUS_AUTHORIZATION=
TELEMETRY_REPORT_SECRET=replace-with-a-random-report-secret
TELEMETRY_REVOKE_SECRET=replace-with-a-random-revoke-secret
TELEMETRY_CONSENT_SYNC_SECRET=replace-with-a-random-consent-sync-secret
TELEMETRY_COLLECTOR_PORT=4318
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_PRIVACY_THRESHOLD=10
TELEMETRY_ROLLUP_INTERVAL_MS=900000
