{
  "name": "rudder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-shell.mjs dev",
    "dev:watch": "node scripts/dev-shell.mjs watch",
    "dev:reset": "node cli/node_modules/tsx/dist/cli.mjs scripts/reset-local-instance.ts --local-env dev",
    "dev:server": "pnpm --filter @rudderhq/server dev",
    "dev:ui": "pnpm --filter @rudderhq/ui dev",
    "identity:dev": "pnpm --filter @rudderhq/identity dev",
    "identity:migrate": "pnpm --filter @rudderhq/identity-db migrate",
    "identity:test": "pnpm --filter @rudderhq/identity-core test && pnpm --filter @rudderhq/identity-db test && pnpm --filter @rudderhq/identity test",
    "lint": "node scripts/lint-imports.mjs",
    "lint:changed": "node scripts/lint-imports.mjs --changed",
    "lint:fix": "node scripts/lint-imports.mjs --fix",
    "mcp-contract:generate": "node cli/node_modules/tsx/dist/cli.mjs scripts/generate-rudder-mcp-tool-descriptors.ts",
    "mcp-contract:check": "node cli/node_modules/tsx/dist/cli.mjs scripts/generate-rudder-mcp-tool-descriptors.ts --check",
    "architecture:audit": "node scripts/architecture-audit.mjs",
    "architecture:audit:test": "node --test scripts/architecture-audit.test.mjs scripts/architecture-boundaries.test.mjs",
    "architecture:audit:check": "node scripts/architecture-audit.mjs --baseline scripts/architecture-audit-baseline.json --compare-ref origin/main --fail-on-regression",
    "architecture:boundaries": "node scripts/architecture-boundaries.mjs",
    "product-logic:check": "node scripts/product-logic-check.mjs",
    "product-logic:test": "node --test scripts/product-logic-check.test.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest",
    "test:run": "pnpm --filter @rudderhq/identity-core build && vitest run",
    "db:generate": "pnpm --filter @rudderhq/db generate",
    "db:migrate": "pnpm --filter @rudderhq/db migrate",
    "secrets:migrate-inline-env": "tsx scripts/migrate-inline-env-secrets.ts",
    "db:backup": "./scripts/backup-db.sh",
    "rudder": "node cli/node_modules/tsx/dist/cli.mjs cli/src/index.ts",
    "build:npm": "./scripts/build-npm.sh",
    "release": "./scripts/release.sh",
    "release:canary": "./scripts/release.sh canary",
    "release:stable": "./scripts/release.sh stable",
    "release:github": "./scripts/create-github-release.sh",
    "release:rollback": "./scripts/rollback-latest.sh",
    "check:tokens": "node scripts/check-forbidden-tokens.mjs",
    "smoke:openclaw-join": "./scripts/smoke/openclaw-join.sh",
    "smoke:openclaw-docker-ui": "./scripts/smoke/openclaw-docker-ui.sh",
    "smoke:openclaw-sse-standalone": "./scripts/smoke/openclaw-sse-standalone.sh",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --config tests/e2e/playwright.config.ts --headed",
    "test:docs-search": "playwright test --config tests/docs-search/playwright.config.ts",
    "perf:workflows": "node cli/node_modules/tsx/dist/cli.mjs scripts/perf/workflow-baseline.ts",
    "perf:thread-pressure": "node cli/node_modules/tsx/dist/cli.mjs scripts/perf/run-isolated-workflow.ts --scale thread-heavy --iterations 20 --warmups 3 --explain",
    "perf:scroll-eval:compare": "node scripts/perf/compare-scroll-evals.mjs",
    "docs:dev": "cd docs && npx -y mint@4.2.637 dev",
    "docs:validate": "cd docs && PUPPETEER_SKIP_DOWNLOAD=1 npx -y mint@4.2.637 validate",
    "docs:metadata:generate": "node scripts/docs-content-map.mjs generate",
    "docs:integrity": "node scripts/docs-content-map.mjs integrity",
    "docs:alignment": "node scripts/docs-content-map.mjs alignment",
    "docs:static:verify": "node scripts/verify-docs-static-export.mjs",
    "docs:structure:test": "node --test scripts/docs-content-map.test.mjs scripts/postprocess-docs-export.test.mjs",
    "docs:health": "node scripts/check-docs-public-health.mjs",
    "desktop:build": "pnpm --filter @rudderhq/desktop build",
    "desktop:dist": "pnpm --filter @rudderhq/desktop dist",
    "desktop:verify": "pnpm --filter @rudderhq/cli build && pnpm --filter @rudderhq/desktop build && pnpm --filter @rudderhq/desktop smoke && pnpm desktop:dist && node desktop/scripts/smoke.mjs --mode=packaged",
    "landing:shots": "node cli/node_modules/tsx/dist/cli.mjs .agents/skills/maintainer/mock-data-maintainer/scripts/capture-landing-proof-shots.ts",
    "mock:data:landing": "LANDING_SHOTS_SKIP_CAPTURE=1 LANDING_SHOTS_HOLD_OPEN=1 node cli/node_modules/tsx/dist/cli.mjs .agents/skills/maintainer/mock-data-maintainer/scripts/capture-landing-proof-shots.ts",
    "prod": "node scripts/prod-desktop.mjs",
    "evals:smoke": "node scripts/evals-smoke-legacy.mjs",
    "test:release-smoke": "npx playwright test --config tests/release-smoke/playwright.config.ts",
    "test:release-smoke:headed": "npx playwright test --config tests/release-smoke/playwright.config.ts --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.16.0",
      "defu": "6.1.5",
      "fast-uri": "3.1.2",
      "fast-xml-builder": "1.1.7",
      "fast-xml-parser": "5.7.0",
      "form-data": "4.0.6",
      "js-yaml": "4.2.0",
      "lodash-es": "4.18.1",
      "path-to-regexp": "8.4.2",
      "protobufjs": "7.6.3",
      "qs": "6.15.2",
      "set-cookie-parser": "3.1.1",
      "undici": "7.28.0",
      "uuid": "11.1.1"
    },
    "patchedDependencies": {
      "@tanstack/react-virtual@3.14.8": "patches/@tanstack__react-virtual@3.14.8.patch"
    }
  },
  "packageManager": "pnpm@9.15.4"
}
