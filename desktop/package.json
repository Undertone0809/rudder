{
  "name": "@rudderhq/desktop",
  "version": "0.7.9",
  "private": true,
  "description": "Rudder Desktop local-first Electron shell",
  "author": "Rudder",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm --filter @rudderhq/identity-core build && pnpm --filter @rudderhq/server prepare:ui-dist && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && pnpm run stage:app-builder-toolchain && node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "dist": "pnpm run build && node scripts/prune-packaging-node-modules.mjs && node scripts/dist.mjs && node scripts/verify-server-package.mjs",
    "prune:packaging-node-modules": "node scripts/prune-packaging-node-modules.mjs",
    "stage:server": "node scripts/stage-server.mjs",
    "stage:cli": "node scripts/stage-cli.mjs",
    "stage:native": "node scripts/stage-native.mjs",
    "stage:app": "node scripts/stage-app.mjs",
    "stage:app-builder-toolchain": "node scripts/stage-app-builder-toolchain.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs && node scripts/run-electron-script.mjs scripts/update-session-fetch-smoke.mjs && node scripts/app-builder-smoke.mjs",
    "smoke:app-builder": "pnpm build && node scripts/app-builder-smoke.mjs",
    "smoke:app-builder:packaged": "node scripts/app-builder-smoke.mjs --packaged"
  },
  "dependencies": {
    "@rudderhq/identity-core": "workspace:*",
    "@rudderhq/shared": "workspace:*",
    "@trycua/cua-driver": "0.19.2",
    "pnpm": "9.15.4"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "@types/node": "^24.12.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "tsx": "^4.21.0"
  },
  "build": {
    "appId": "ai.rudder.desktop",
    "productName": "Rudder",
    "executableName": "Rudder",
    "asar": false,
    "directories": {
      "app": ".packaged/app",
      "output": "release"
    },
    "afterPack": "./scripts/after-pack.mjs",
    "extraResources": [
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon-dev.png",
        "to": "icon-dev.png"
      },
      {
        "from": "../ui/public/rudder-logo.png",
        "to": "rudder-logo.png"
      },
      {
        "from": ".packaged/native",
        "to": "native"
      }
    ],
    "dmg": {
      "title": "Rudder",
      "size": 5500
    },
    "files": [
      "dist/**/*",
      "releases/**/*",
      "package.json",
      "!**/node_modules/electron",
      "!**/node_modules/electron/**/*",
      "!**/node_modules/electron-builder",
      "!**/node_modules/electron-builder/**/*",
      "!**/node_modules/@electron",
      "!**/node_modules/@electron/**/*"
    ],
    "mac": {
      "identity": null,
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
