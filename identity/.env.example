# Identity runtime (use separate values for development, preview, and production)
IDENTITY_RELEASE_CHANNEL=development
IDENTITY_BASE_URL=http://127.0.0.1:3200
IDENTITY_DATABASE_URL=postgres://identity:identity@127.0.0.1:5432/identity
IDENTITY_MIGRATION_DATABASE_URL=postgres://identity:identity@127.0.0.1:5432/identity
IDENTITY_BETTER_AUTH_SECRET=
IDENTITY_ALLOWED_ORIGINS=http://127.0.0.1:3200
IDENTITY_DEVICE_CLIENT_IDS=rudder-desktop,rudder-cli
IDENTITY_SUPPORT_EMAIL=support@rudderhq.dev

# OAuth apps must be environment-specific. Omit both members of a provider pair
# to disable that provider in local development.
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_GOOGLE_CLIENT_SECRET=
IDENTITY_GITHUB_CLIENT_ID=
IDENTITY_GITHUB_CLIENT_SECRET=

# capture is development/test-only. Production must use resend.
IDENTITY_MAIL_MODE=capture
IDENTITY_RESEND_API_KEY=
IDENTITY_MAIL_FROM=Rudder Account <account@updates.rudderhq.dev>
