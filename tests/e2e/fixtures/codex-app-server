#!/usr/bin/env node
import readline from "node:readline";

const threadId = "thread-e2e-app-server";
const turnId = "turn-e2e-app-server";
const send = (message) => process.stdout.write(`${JSON.stringify(message)}\n`);
let prompt = "";
let completed = false;
let fallbackTimer = null;

function resultSentinel() {
  return prompt.match(/(__RUDDER_RESULT_[a-f0-9-]+__)/i)?.[1] ?? "__RUDDER_RESULT_TEST__";
}

function finish(body, status = "completed") {
  if (completed) return;
  completed = true;
  if (fallbackTimer) clearTimeout(fallbackTimer);
  if (status !== "interrupted") {
    const finalText = `${body}\n${resultSentinel()}${JSON.stringify({
      kind: "message",
      body,
      structuredPayload: null,
    })}`;
    send({
      method: "thread/tokenUsage/updated",
      params: {
        threadId,
        turnId,
        tokenUsage: {
          total: {
            totalTokens: 4,
            inputTokens: 2,
            cachedInputTokens: 0,
            outputTokens: 2,
            reasoningOutputTokens: 0,
          },
          last: {
            totalTokens: 4,
            inputTokens: 2,
            cachedInputTokens: 0,
            outputTokens: 2,
            reasoningOutputTokens: 0,
          },
          modelContextWindow: 1000,
        },
      },
    });
    send({
      method: "item/agentMessage/delta",
      params: { threadId, turnId, itemId: "agent-e2e", delta: finalText },
    });
    send({
      method: "item/completed",
      params: {
        threadId,
        turnId,
        completedAtMs: Date.now(),
        item: {
          type: "agentMessage",
          id: "agent-e2e",
          text: finalText,
          phase: null,
          memoryCitation: null,
        },
      },
    });
  }
  send({
    method: "turn/completed",
    params: {
      threadId,
      turn: {
        id: turnId,
        items: [],
        itemsView: { type: "full" },
        status,
        error: null,
        startedAt: 1,
        completedAt: 2,
        durationMs: 1,
      },
    },
  });
}

function finishStreamedMarkdown(body) {
  if (completed) return;
  completed = true;
  if (fallbackTimer) clearTimeout(fallbackTimer);
  const resultEnvelope = `\n${resultSentinel()}${JSON.stringify({
    kind: "message",
    body,
    structuredPayload: null,
  })}`;
  const finalText = `${body}${resultEnvelope}`;
  send({
    method: "item/agentMessage/delta",
    params: { threadId, turnId, itemId: "streamed-markdown-e2e", delta: resultEnvelope },
  });
  send({
    method: "item/completed",
    params: {
      threadId,
      turnId,
      completedAtMs: Date.now(),
      item: {
        type: "agentMessage",
        id: "streamed-markdown-e2e",
        text: finalText,
        phase: null,
        memoryCitation: null,
      },
    },
  });
  send({
    method: "turn/completed",
    params: {
      threadId,
      turn: {
        id: turnId,
        items: [],
        itemsView: { type: "full" },
        status: "completed",
        error: null,
        startedAt: 1,
        completedAt: 2,
        durationMs: 1,
      },
    },
  });
}

function emitReasoning(itemId, text) {
  send({
    method: "item/completed",
    params: {
      threadId,
      turnId,
      item: { type: "reasoning", id: itemId, summary: [text], content: [] },
    },
  });
}

const rl = readline.createInterface({ input: process.stdin });
rl.on("line", (line) => {
  const message = JSON.parse(line);
  if (message.method === "initialized") return;
  if (message.method === "initialize") {
    send({ id: message.id, result: { userAgent: "rudder-e2e-app-server" } });
    return;
  }
  if (message.method === "thread/start" || message.method === "thread/resume") {
    send({ id: message.id, result: { thread: { id: threadId } } });
    return;
  }
  if (message.method === "turn/start") {
    prompt = (message.params?.input ?? [])
      .filter((item) => item?.type === "text" && typeof item.text === "string")
      .map((item) => item.text)
      .join("\n");
    send({ id: message.id, result: { turn: { id: turnId } } });
    send({ method: "turn/started", params: { threadId, turn: { id: turnId } } });
    if (prompt.includes("Keep streamed Markdown nodes stable")) {
      const firstFragment = "- [Rudder](https://rudderhq.dev/docs)";
      const appendedFragments = Array.from(
        { length: 20 },
        (_, index) => `\n- Streamed item ${index + 1}`,
      );
      const body = `${firstFragment}${appendedFragments.join("")}`;
      send({
        method: "item/started",
        params: {
          threadId,
          turnId,
          item: {
            type: "agentMessage",
            id: "streamed-markdown-e2e",
            text: "",
            phase: null,
            memoryCitation: null,
          },
        },
      });
      [firstFragment, ...appendedFragments].forEach((delta, index) => {
        setTimeout(() => {
          send({
            method: "item/agentMessage/delta",
            params: {
              threadId,
              turnId,
              itemId: "streamed-markdown-e2e",
              delta,
            },
          });
        }, 250 + index * 150);
      });
      setTimeout(() => finishStreamedMarkdown(body), 4_600);
    }
    if (
      prompt.includes("Keep commentary in Process")
      || prompt.includes("Complete fragmented commentary")
    ) {
      const commentary = "我会先读取 `rudder-docs`，再核对源码；确认字符不会丢失。";
      send({
        method: "item/started",
        params: {
          threadId,
          turnId,
          item: {
            type: "agentMessage",
            id: "commentary-e2e",
            text: "",
            phase: "commentary",
            memoryCitation: null,
          },
        },
      });
      [
        "我会先读取 `rudder",
        "-docs`，再核对源",
        "码；确认字符不会丢失。",
      ].forEach((delta, index) => {
        setTimeout(() => {
          send({
            method: "item/agentMessage/delta",
            params: {
              threadId,
              turnId,
              itemId: "commentary-e2e",
              delta,
            },
          });
        }, 250 + index * 100);
      });
      if (prompt.includes("Complete fragmented commentary")) {
        setTimeout(() => {
          send({
            method: "item/completed",
            params: {
              threadId,
              turnId,
              item: {
                type: "agentMessage",
                id: "commentary-e2e",
                text: commentary,
                phase: "commentary",
                memoryCitation: null,
              },
            },
          });
        }, 600);
        setTimeout(() => finish("Fragmented commentary completed."), 900);
      }
    }
    if (prompt.includes("Keep Steer message position stable")) {
      setTimeout(() => emitReasoning("reason-before-steer", "Reasoning before Steer"), 600);
    }
    if (prompt.includes("Render dual reasoning streams")) {
      setTimeout(() => {
        for (const delta of ["I will use ", "visualize once."]) {
          send({
            method: "item/reasoning/summaryTextDelta",
            params: { threadId, turnId, itemId: "reason-e2e", summaryIndex: 0, delta },
          });
          // Emit both protocol streams to verify Rudder selects one per item.
          send({
            method: "item/reasoning/textDelta",
            params: { threadId, turnId, itemId: "reason-e2e", contentIndex: 0, delta },
          });
        }
        send({
          method: "item/completed",
          params: {
            threadId,
            turnId,
            item: { type: "reasoning", id: "reason-e2e", summary: ["I will use visualize once."], content: [] },
          },
        });
      }, 500);
    }
    fallbackTimer = setTimeout(
      () => finish(`Initial App Server reply (${prompt.includes("Keep Steer message position stable") ? "marker-true" : "marker-false"})`),
      prompt.includes("Render dual reasoning streams")
        ? 1_000
        : prompt.includes("Keep streamed Markdown nodes stable")
          ? 60_000
        : prompt.includes("Keep commentary in Process")
          ? 60_000
        : prompt.includes("Complete fragmented commentary")
          ? 5_000
        : prompt.includes("Keep Steer message position stable")
          ? 60_000
          : 30_000,
    );
    return;
  }
  if (message.method === "turn/steer") {
    if (message.params?.expectedTurnId !== turnId) {
      send({
        id: message.id,
        error: { code: -32602, message: "expectedTurnId does not match the active turn" },
      });
      return;
    }
    const feedback = message.params?.input?.find((item) => item?.type === "text")?.text ?? "feedback";
    const receivedLocalImage = message.params?.input?.some((item) => item?.type === "localImage")
      ?? false;
    send({ id: message.id, result: { turnId } });
    const finishSteeredTurn = () => finish([
      `Native steer applied: ${feedback}`,
      `Native steer image received: ${receivedLocalImage}`,
    ].join("\n\n"));
    if (prompt.includes("Keep Steer message position stable")) {
      setTimeout(() => emitReasoning("reason-after-steer", "Reasoning after Steer"), 250);
      setTimeout(finishSteeredTurn, 1_000);
    } else {
      finishSteeredTurn();
    }
    return;
  }
  if (message.method === "turn/interrupt") {
    send({ id: message.id, result: {} });
    finish("", "interrupted");
  }
});

process.on("SIGTERM", () => process.exit(0));
